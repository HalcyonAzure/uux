# Source before building on the Linux host. Paths match the README layout.
. $HOME/.cargo/env
export SDKROOT=/opt/osx/MacOSX26.5.sdk
export MACOSX_DEPLOYMENT_TARGET=13.0
export CC_aarch64_apple_darwin=/opt/osx/bin/mac-cc
export CXX_aarch64_apple_darwin=/opt/osx/bin/mac-cxx
export AR_aarch64_apple_darwin=/opt/osx/bin/mac-ar
export CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER=/opt/osx/bin/mac-cc
export PKG_CONFIG_ALLOW_CROSS=1
export PKG_CONFIG_SYSROOT_DIR=/
export PKG_CONFIG_LIBDIR=/opt/osx/deps/lib/pkgconfig
export PKG_CONFIG_PATH=
export BINDGEN_EXTRA_CLANG_ARGS_aarch64_apple_darwin="--target=arm64-apple-macos13.0 -isysroot $SDKROOT -I/opt/osx/deps/include"
export LIBOPUS_STATIC=1
export LIBOPUS_LIB_DIR=/opt/osx/deps/lib
export OPUS_STATIC=1
